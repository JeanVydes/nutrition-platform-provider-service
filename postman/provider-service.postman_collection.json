    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
                    "",
                    "function ensureUuid(varName) {",
                    "  const current = pm.environment.get(varName);",
                    "  if (!current || !uuidRegex.test(current)) {",
                    "    const generated = pm.variables.replaceIn('{{$guid}}');",
                    "    pm.environment.set(varName, generated);",
                    "  }",
                    "}",
                    "",
                    "if (!pm.environment.get('BASE_URL')) {",
                    "  pm.environment.set('BASE_URL', 'http://localhost:8080');",
                    "}",
                    "",
                    "if (!pm.environment.get('ACCESS_TOKEN')) {",
                    "  pm.environment.set('ACCESS_TOKEN', 'offline-token');",
                    "}",
                    "",
                    "ensureUuid('PROVIDER_ACCOUNT_ID');",
                    "ensureUuid('WORKER_ACCOUNT_ID');",
                    "ensureUuid('SCHOOL_ID');"
                ]
            }
        }
    ],
